# This app does NOT use any LLM/AI provider. No OPENAI_*, ANTHROPIC_*, etc. are read.

# Username for the login form — change before deploying
BASIC_AUTH_USERNAME=garrett
# Password for the login form — use a strong random value; stored with constant-time comparison
BASIC_AUTH_PASSWORD=replace-with-strong-random
# Secret used to sign the polyglot_session cookie (HS256). 32+ char random string.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-32-plus-char-random-secret

# Optional: Vercel KV REST API endpoint — enables cross-device progress sync
KV_REST_API_URL=
# Optional: Vercel KV REST API token — required when KV_REST_API_URL is set
KV_REST_API_TOKEN=
